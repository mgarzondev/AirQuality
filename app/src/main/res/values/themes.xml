        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/primaryForeground</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/secondaryForeground</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/foreground</item>

        <item name="colorSurfaceVariant">@color/muted</item>
        <item name="colorOnSurfaceVariant">@color/accentForeground</item>
        <item name="colorOutline">@color/border</item>

        <item name="textAppearanceBody1">@color/foreground</item>

        <item name="cardElevation">@color/border</item>

        <item name="colorError">@color/Destructive</item>

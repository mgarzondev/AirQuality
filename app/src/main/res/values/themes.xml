    <style name="Theme.AirQuality" parent="Base.Theme.AirQuality" />

    <style name="ShapeAppearance.AirQuality.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

